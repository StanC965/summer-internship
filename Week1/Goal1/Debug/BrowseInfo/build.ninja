##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = D$:\Mircea\Marqurdt\logic\common\bin\XclFileGenerator.exe $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$in
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = D$:\Mircea\Marqurdt\logic\common\bin\SourceIndexer.exe $flags
  depfile = $out.dep
  description = IAR_NEW_TOOL+++INDEXER+++$out

rule MAKEBROWSE
  command = D$:\Mircea\Marqurdt\logic\common\bin\makeBrowseData.exe $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out

rule PDBLINK
  command = D$:\Mircea\Marqurdt\logic\common\bin\PbdLink.exe $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out



#Build steps
build D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.xcl : COMPILER_XCL 
  xclcommand = -source_file D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\main.c -xcl_file D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.xcl -macro_file D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.tmp -icc_path D$:\Mircea\Marqurdt\logic\avr\bin\iccavr.exe
  flags = D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\main.c -v3 --enhanced_core -ms -o D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\Obj\ -y --initializers_in_flash --no_cse --no_inline --no_code_motion --no_cross_call --no_clustering --no_tbaa --debug -e --dlib --dlib_config DLib_Config_Normal.h -Ol --predef_macros D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.tmp
  rspfile_name = D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.xcl.rsp

build D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.pbi : INDEXER D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.xcl |  $
D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\main.c
  flags = -out=D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.pbi -f D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.xcl

build D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbw : MAKEBROWSE D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbd
  flags = D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbd -output D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbw

build D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbd : PDBLINK D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.pbi
  flags = -M D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\Task152.pbd D$:\Mircea\Marqurdt\summer-internship\Week1\Goal1\Debug\BrowseInfo\main.pbi

