  flags = "-out=C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.pbi" -f "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.xcl"

