C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\uart.c
  flags = "-out=C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.pbi" -f "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.xcl"

build C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\Goal7.pbw : MAKEBROWSE C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\Goal7.pbd
