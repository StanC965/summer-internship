##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\XclFileGenerator.exe" $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$in
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\SourceIndexer.exe" $flags
  depfile = $out.dep
  description = IAR_NEW_TOOL+++INDEXER+++$out

rule MAKEBROWSE
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\makeBrowseData.exe" $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out

rule PDBLINK
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\PbdLink.exe" $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out



#Build steps
build C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.xcl : COMPILER_XCL 
  xclcommand = -source_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\main.c" -xcl_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.xcl" -macro_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.tmp" -icc_path "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\avr\bin\iccavr.exe"
  flags = "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\main.c" --cpu=m324pb -ms -o "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\Obj\\" --initializers_in_flash --no_cse --no_inline --no_code_motion --no_cross_call --no_clustering --no_tbaa --debug -e --eeprom_size 1024 --dlib --dlib_config DLib_Config_Normal.h -On --predef_macros "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.tmp"
  rspfile_name = C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.xcl.rsp

build C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.xcl : COMPILER_XCL 
  xclcommand = -source_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\uart.c" -xcl_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.xcl" -macro_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.tmp" -icc_path "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\avr\bin\iccavr.exe"
  flags = "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\uart.c" --cpu=m324pb -ms -o "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\Obj\\" --initializers_in_flash --no_cse --no_inline --no_code_motion --no_cross_call --no_clustering --no_tbaa --debug -e --eeprom_size 1024 --dlib --dlib_config DLib_Config_Normal.h -On --predef_macros "C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.tmp"
  rspfile_name = C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\uart.xcl.rsp

build C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.pbi : INDEXER C$:\MQ_Summer_Internship\summer-internship\Week$ 3\Goal$ 7\Debug\BrowseInfo\main.xcl |  $
