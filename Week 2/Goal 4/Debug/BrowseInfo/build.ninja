##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\XclFileGenerator.exe" $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$in
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\SourceIndexer.exe" $flags
  depfile = $out.dep
  description = IAR_NEW_TOOL+++INDEXER+++$out

rule MAKEBROWSE
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\makeBrowseData.exe" $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out

rule PDBLINK
  command = "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\common\bin\PbdLink.exe" $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out



#Build steps
build C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.xcl : COMPILER_XCL 
  xclcommand = -source_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\main.c" -xcl_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.xcl" -macro_file "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.tmp" -icc_path "C$:\Program$ Files\IAR$ Systems\Embedded$ Workbench$ 9.1\avr\bin\iccavr.exe"
  flags = "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\main.c" -v3 --enhanced_core -ms -o "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\Obj\\" -y --initializers_in_flash --no_cse --no_inline --no_code_motion --no_cross_call --no_clustering --no_tbaa --debug -e --dlib --dlib_config DLib_Config_Normal.h -Ol --predef_macros "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.tmp"
  rspfile_name = C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.xcl.rsp

build C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.pbi : INDEXER C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.xcl |  $
C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\main.c
  flags = "-out=C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.pbi" -f "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.xcl"

build C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbw : MAKEBROWSE C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbd
  flags = "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbd" -output "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbw"

build C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbd : PDBLINK C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.pbi
  flags = -M "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\Goal$ 4.pbd" "C$:\MQ_Summer_Internship\summer-internship\Week$ 2\Goal$ 4\Debug\BrowseInfo\main.pbi"

