  flags = C$:\Users\Bibi\Desktop\summer-internship\Week1Goal1\main.c --cpu=m324pb -ms -o C$:\Users\Bibi\Desktop\summer-internship\Week1Goal1\Debug\Obj\ --initializers_in_flash --no_cse --no_inline --no_code_motion --no_cross_call --no_clustering --no_tbaa --debug -e --eeprom_size 1024 --dlib --dlib_config DLib_Config_Normal.h -On --predef_macros C$:\Users\Bibi\Desktop\summer-internship\Week1Goal1\Debug\BrowseInfo\main.tmp
