{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "AVR-GDB: hardware mEDBG (ATmega324PB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src/atmega324pb-blink/build/blink.elf",
      "cwd": "${workspaceFolder}/src/atmega324pb-blink",
      "MIMode": "gdb",
      "miDebuggerPath": "avr-gdb",
      "miDebuggerServerAddress": "localhost:4242",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set architecture",
          "text": "set architecture avr:5",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
