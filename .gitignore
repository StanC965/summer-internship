# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# MkDocs build output
site/

# Python virtual environments
.venv/
venv/
env/

# Python cache and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Microsoft Office temporary lock files
~$*


